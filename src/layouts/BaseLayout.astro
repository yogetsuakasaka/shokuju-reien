---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBar from '../components/CtaBar.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  path: string;
  /** JSON-LD。schema.org に実在する型のみ。確認できない項目は入れない。 */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, jsonLd = [] } = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://shokuju-reien.jp').href;
const fullTitle = path === '/' ? title : `${title}｜${site.shortName}`;

/**
 * OGP画像（SNSでシェアされたときの画像）。
 * public/ogp.jpg は `npm run ogp` で作り直せます（scripts/make-ogp.mjs）。
 * 絶対URLでないとSNS側が読み込めないため、canonical と同じオリジンで組み立てます。
 */
const ogImage = new URL('/ogp.jpg', Astro.site ?? 'https://shokuju-reien.jp').href;
const ogImageAlt = '上空から見た青松山 平成院の境内と、周囲の山あいの森';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    <script is:inline>
      // JS が有効なときだけ Reveal 用の初期状態を適用する。
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="has-cta-bar">
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <CtaBar path={path} />

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var targets = document.querySelectorAll('[data-reveal]');

        function showAll() {
          for (var i = 0; i < targets.length; i++) targets[i].classList.add('is-visible');
        }

        if (reduce || !('IntersectionObserver' in window)) {
          showAll();
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          for (var i = 0; i < targets.length; i++) io.observe(targets[i]);
          // 万一 Observer が発火しない環境でも、本文が読めない状態を残さない。
          setTimeout(showAll, 3000);
        }

        // メニュー（<details>）は、外側をタップするか Esc で閉じる。
        var menu = document.querySelector('.menu');
        if (menu) {
          document.addEventListener('click', function (e) {
            if (menu.hasAttribute('open') && !menu.contains(e.target)) {
              menu.removeAttribute('open');
            }
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && menu.hasAttribute('open')) {
              menu.removeAttribute('open');
              var t = menu.querySelector('summary');
              if (t) t.focus();
            }
          });
        }

        // 固定CTA：Hero があれば Hero を過ぎてから、なければ少しスクロールしたら出す。
        var bar = document.getElementById('cta-bar');
        var hero = document.querySelector('.hero');
        if (bar) {
          if (hero && 'IntersectionObserver' in window) {
            new IntersectionObserver(
              function (entries) {
                bar.classList.toggle('is-shown', !entries[0].isIntersecting);
              },
              { threshold: 0 }
            ).observe(hero);
          } else {
            var onScroll = function () {
              bar.classList.toggle('is-shown', window.scrollY > 240);
            };
            onScroll();
            window.addEventListener('scroll', onScroll, { passive: true });
          }
        }
      })();
    </script>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Figure from '../../components/Figure.astro';
import site from '../../data/site.json';

const title = 'アクセス・ご見学のご案内';
const description =
  '青松山 平成院 植樹葬霊園の所在地は岩手県九戸郡洋野町大野11-30-53。霊園事務局 TEL 0194-77-4411、八戸案内所 TEL 0178-24-4888。ご見学・ご相談はお電話で承ります。';

// 地図は埋め込まず、外部の地図アプリを開くリンクにする（通信量と読み込み時間のため）。
const mapQuery = encodeURIComponent(`${site.office.address} ${site.organization}`);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://shokuju-reien.jp/' },
      { '@type': 'ListItem', position: 2, name: 'アクセス', item: 'https://shokuju-reien.jp/access/' },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/access/" jsonLd={jsonLd}>
  <Breadcrumb current="アクセス" />

  <div class="page-head wrap">
    <h1>アクセス・ご見学</h1>
    <p>ご見学・ご相談は、お電話で承っています。</p>
  </div>

  {/* 最重要情報を最上部に、テキストで置く */}
  <section class="section--tight wrap" aria-labelledby="office">
    <h2 class="section__title" id="office">霊園事務局</h2>
    <dl class="info" style="margin-top:var(--s5)">
      <div>
        <dt>所在地</dt>
        <dd>
          〒{site.office.postalCode}<br />
          {site.office.address}
        </dd>
      </div>
      <div>
        <dt>電話</dt>
        <dd><a href={site.office.telHref}>{site.office.tel}</a></dd>
      </div>
      <div>
        <dt>FAX</dt>
        <dd>{site.office.fax}</dd>
      </div>
      <div>
        <dt>管理者</dt>
        <dd>{site.organization}</dd>
      </div>
    </dl>

    <p style="margin-top:var(--s6)">
      <a class="btn btn--primary" href={site.office.telHref}>
        <span aria-hidden="true">☎</span>霊園事務局に電話する
      </a>
    </p>
    <p style="margin-top:var(--s4)">
      <a href={mapUrl} rel="noopener noreferrer" target="_blank">
        地図アプリで所在地を開く（外部サイト）
      </a>
    </p>
  </section>

  <section class="section wrap" aria-labelledby="hachinohe">
    <h2 class="section__title" id="hachinohe">{site.hachinohe.label}</h2>
    <dl class="info" style="margin-top:var(--s5)">
      <div>
        <dt>所在地</dt>
        <dd>{site.hachinohe.address}</dd>
      </div>
      <div>
        <dt>電話</dt>
        <dd><a href={site.hachinohe.telHref}>{site.hachinohe.tel}</a></dd>
      </div>
    </dl>
  </section>

  <section class="section--tight wrap">
    <Figure name="access-entrance" sizes="(min-width: 900px) 70vw, 92vw" />
  </section>

  <section class="section">
    <div class="wrap-text prose">
      <h2>墓参について</h2>
      <p>
        お参りいただける期間は、原則として{site.visit.period}の{site.visit.hours}です。
      </p>
      <p>{site.visit.note}</p>

      <h2>ご見学</h2>
      <p>
        ご見学をご希望の方は、霊園事務局（<a href={site.office.telHref}>{site.office.tel}</a>）へお電話ください。{
          site.hachinohe.label
        }（<a href={site.hachinohe.telHref}>{site.hachinohe.tel}</a>）にもお問い合わせいただけます。
      </p>
      <p class="source-note">
        お車でお越しの際の駐車場、公共交通機関でのご来園方法については、霊園事務局へお問い合わせください。
      </p>

      <ul class="linkcards" style="margin-top:var(--s8)">
        <li><a href="/concept/">植樹葬とは</a></li>
        <li><a href="/plans/">費用と区画</a></li>
        <li><a href="/faq/">よくあるご質問</a></li>
        <li><a href="/about/">平成院について</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

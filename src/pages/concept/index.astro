---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Figure from '../../components/Figure.astro';
import site from '../../data/site.json';
import trees from '../../data/trees.json';

const title = '植樹葬とは｜自ら植えた木のもとに眠る樹木葬';
const description =
  '平成院の植樹葬は、生前にご自身で墓標となる花木を選んで苗木を植え、没後はその木のもとに埋蔵される樹木葬です。岩手県洋野町の青松山 平成院が、植樹葬の考え方、墓地の類型と花木、埋蔵の方法をご説明します。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://shokuju-reien.jp/' },
      { '@type': 'ListItem', position: 2, name: '植樹葬とは', item: 'https://shokuju-reien.jp/concept/' },
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/concept/" jsonLd={jsonLd}>
  <Breadcrumb current="植樹葬とは" />

  <div class="page-head wrap">
    <h1>植樹葬とは</h1>
    <p class="lead">
      植樹葬は、平成院が行う樹木葬の一種です。生前にご自身で墓標となる花木を選び、その苗木を植えるところから始まります。植えた木は墓標となり、没後はその木のもとへ埋蔵されます。
    </p>
  </div>

  <div class="wrap-text prose section">
    <h2>植樹葬の理念</h2>
    <p>当山の規約では、この墓地の趣旨を次のように定めています。</p>
    <p>
      「人としてこの世に生を受け、自然界の恵みを一身に受けながら生かされてきたことへの感謝の証しとして植樹し、没後、自ら植えた樹木のそばで大地に還る」
    </p>

    <h2>生前に、自分の木を植える</h2>
    <p>
      平成院では、あらかじめ植えられている木を墓標とするのではなく、お一人ひとりがご自身の木を植えるところから始まります。
    </p>
    <p>
      ご契約のときに、墓標としての花木を選び、その苗木を植えます。植樹の際は平成院がお手伝いします。
    </p>
    <p>{site.planting.attendance}</p>
  </div>

  <div class="wrap section--tight">
    <Figure name="monument-hoshi" sizes="(min-width: 900px) 70vw, 92vw" caption="境内の石碑「星と花と木のもとで」" />
  </div>

  <div class="wrap-text prose section">
    <h2>墓地の類型</h2>

    <h3>樹木選択型墓地の場合</h3>
    <p>樹木選択型墓地では、現在次のような花木が選択されています。</p>
    <ul class="chips" style="margin-top:var(--s4)">
      {trees.memorialTrees.map((t) => <li>{t.name}{t.note ? `（${t.note}）` : ''}</li>)}
    </ul>

    <h3>樹木限定型墓地の場合</h3>
    <p>樹木限定型墓地では、植樹できる花木は次の2種に限定しております。</p>
    <ul class="chips" style="margin-top:var(--s4)">
      {trees.limitedTypeSpecies.map((s) => <li>{s}</li>)}
    </ul>

    <h2>その木のもとで、眠る</h2>
    <p>会員が亡くなられた後、ご自身が植えた花木のもとに埋蔵されます。</p>
    <p>
      焼骨は、管理者が用意する骨袋へ移し替え、管理者立会いのもとで土中へ埋蔵します。焼骨以外の副葬品等は埋蔵できません。
    </p>

    <h2>宗教・宗派不問</h2>
    <p>宗教・宗派を問わずご入会いただけます。</p>
    <p>合同追悼式については管理者（平成院）が執行します。</p>
  </div>

  <div class="wrap section--tight">
    <Figure name="monument-saigyo" sizes="(min-width: 900px) 70vw, 92vw" caption="境内の西行法師の歌碑" />
  </div>

  <div class="wrap-text prose section">
    <h2>墓参について</h2>
    <p>積雪量が多い時季がありますので、冬期間は管理者へご連絡ください。</p>

    <ul class="linkcards" style="margin-top:var(--s8)">
      <li><a href="/plans/">費用を見る</a></li>
      <li><a href="/faq/">よくあるご質問</a></li>
      <li><a href="/access/">アクセス・ご見学</a></li>
      <li><a href="/rules/">霊園規約</a></li>
    </ul>
  </div>
</BaseLayout>

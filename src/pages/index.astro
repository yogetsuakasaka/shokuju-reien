---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import FaqList from '../components/FaqList.astro';
import site from '../data/site.json';
import plans from '../data/plans.json';
import trees from '../data/trees.json';

const description =
  '岩手県洋野町、14,000坪の境内にある青松山 平成院の植樹葬霊園。生前にご自身で墓標となる花木を選び、苗木を植え、没後はその木のもとへ埋蔵されます。宗教・宗派は問いません。樹木葬・永代供養のご相談を承っています。';

// 物語部分。写真キーは src/data/images.json に対応。
const scenes = [
  { image: 'story-plant', text: '一本の木を、植える。' },
  { image: 'story-seasons', text: 'その木と、季節を重ねる。' },
  { image: 'story-under', text: 'そしていつか、その木のもとへ。' },
  { image: 'story-soil', text: '土から生まれ、土へ還る。' },
];

const seasons = [
  { image: 'season-spring', name: '春', text: '木々が芽吹き、桜がひらきます。' },
  { image: 'season-green', name: '初夏', text: '山あいが、一斉に緑に変わります。' },
  { image: 'season-flower', name: '花の季節', text: 'シャクナゲやヤマアジサイが咲きそろいます。' },
  { image: 'season-autumn', name: '秋', text: '木々が色づき、境内が静まります。' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Cemetery',
    name: site.name,
    url: 'https://shokuju-reien.jp/',
    telephone: site.office.tel,
    faxNumber: site.office.fax,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      postalCode: site.office.postalCode,
      addressRegion: site.office.region,
      addressLocality: site.office.addressLocality,
      streetAddress: site.office.streetAddress,
    },
  },
];
---

<BaseLayout
  title="青松山 平成院 植樹葬霊園｜岩手・洋野町の樹木葬"
  description={description}
  path="/"
  jsonLd={jsonLd}
>
  <Hero />

  {/* ---------- 物語（SCENE 2〜5） ---------- */}
  <section class="section--flush wrap" aria-label="平成院の植樹葬">
    {
      scenes.map((scene) => (
        <div class="scene" data-reveal>
          <div class="scene__media">
            <Figure name={scene.image} sizes="(min-width: 900px) 46vw, 92vw" />
          </div>
          <p class="scene__text">{scene.text}</p>
        </div>
      ))
    }
  </section>

  {/* ---------- 植樹葬とは ---------- */}
  <section class="section section--stone" aria-labelledby="about-shokuju">
    <div class="wrap-text prose" data-reveal>
      <p class="section__label">植樹葬について</p>
      <h2 class="section__title" id="about-shokuju">平成院の植樹葬とは</h2>
      <p class="lead">
        多くの樹木葬では、すでにそこにある木の周囲に納骨します。平成院の植樹葬は、ご契約のときにご自身で墓標となる花木を選び、その苗木を植えるところから始まります。
      </p>
      <p>
        霊園規約 第13条は、この墓地の趣旨を次のように定めています。人としてこの世に生を受け、自然界の恵みを一身に受けながら生かされてきたことへの感謝の証しとして植樹し、没後、自ら植えた樹木のそばで大地に還る——。
      </p>
      <p>
        植樹葬墓地の使用には、会員ご本人による生前の明確な意思表示が必要です。墓地の使用は、会員一代限りとなります。
      </p>
      <p>
        <a class="link-more" href="/concept/">植樹葬の考え方をくわしく見る</a>
      </p>
    </div>
  </section>

  {/* ---------- 3ステップ ---------- */}
  <section class="section wrap" aria-labelledby="steps">
    <div data-reveal>
      <p class="section__label">はじまりから、還るまで</p>
      <h2 class="section__title" id="steps">植樹葬の3つのとき</h2>
    </div>

    <ol class="steps" style="margin-top:var(--s7)" data-reveal>
      <li>
        <h3>選び、植える</h3>
        <p>
          ご契約のときに、墓標となる花木を選びます。植樹の際は平成院がお手伝いします。日時は事前に管理者と協議し、管理者立会いのもとで行います。植樹できる期間は、原則として{
            site.planting.period.replace('原則 ', '')
          }です。
        </p>
      </li>
      <li>
        <h3>季節を重ねる</h3>
        <p>
          植えた木は、季節ごとに姿を変えていきます。お参りいただける期間は、原則として{site.visit.period}の{site.visit.hours}です。気象条件により墓参できない場合があるため、事前に管理者へご連絡ください。
        </p>
      </li>
      <li>
        <h3>その木のもとへ</h3>
        <p>
          会員が亡くなられた後、ご自身が植えた樹木のもとへ埋蔵することができます。焼骨は、管理者が用意する「数年経てば土に溶ける埋蔵用容器」へ移し替え、管理者立会いのもとで土中へ埋蔵します。
        </p>
      </li>
    </ol>
  </section>

  {/* ---------- 四季 ---------- */}
  <section class="section section--stone" aria-labelledby="seasons">
    <div class="wrap">
      <div data-reveal>
        <p class="section__label">四季</p>
        <h2 class="section__title" id="seasons">木とともに、季節がめぐる</h2>
      </div>

      <ul class="seasons" style="margin-top:var(--s7)" data-reveal>
        {
          seasons.map((s) => (
            <li>
              <Figure name={s.image} sizes="(min-width: 820px) 22vw, 44vw" />
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="note" style="margin-top:var(--s6)">{trees.gardenNote}</p>
    </div>
  </section>

  {/* ---------- 14,000坪 ---------- */}
  <section class="section wrap" aria-labelledby="grounds">
    <div data-reveal>
      <p class="section__label">境内</p>
      <h2 class="section__title" id="grounds">{site.areaSize}の境内に</h2>
      <p class="lead" style="margin-top:var(--s5);max-width:var(--measure)">
        青松山 平成院の境内は{site.areaSize}。山あいの森のなかに、植樹葬墓地と永代供養墓があります。
      </p>
    </div>
    <div style="margin-top:var(--s7)" data-reveal>
      <Figure name="grounds-aerial" sizes="100vw" />
    </div>
  </section>

  {/* ---------- 費用 ---------- */}
  <section class="section section--stone" aria-labelledby="plans">
    <div class="wrap">
      <div data-reveal>
        <p class="section__label">費用</p>
        <h2 class="section__title" id="plans">墓地と費用</h2>
      </div>

      <div class="plans-grid" style="margin-top:var(--s7)" data-reveal>
        {
          plans.plantingGraves.map((p) => (
            <article class="plan">
              <h3 class="plan__name">{p.name}</h3>
              <p class="plan__size">{p.size}</p>
              <p class="plan__price">
                <span>{p.unit}</span>
                <b>{p.priceText}</b>
              </p>
              <p class="plan__body">
                {p.entryFee}／{p.annualFeeText}
              </p>
            </article>
          ))
        }
      </div>

      <article class="plan" style="margin-top:var(--s5)" data-reveal>
        <h3 class="plan__name">{plans.eternal.name}</h3>
        <p class="plan__price">
          <b>{plans.eternal.priceText}</b>
          <span>
            （{plans.eternal.breakdown.map((b) => `${b.label}${b.amountText}`).join('＋')}）
          </span>
        </p>
        <p class="plan__body">
          {plans.eternal.annualFeeText}／{plans.eternal.succession}
        </p>
      </article>

      <p style="margin-top:var(--s6)" data-reveal>
        <a class="link-more" href="/plans/">費用と区画をくわしく見る</a>
      </p>
      <p class="note" style="margin-top:var(--s4)">{plans.footnote}</p>
    </div>
  </section>

  {/* ---------- 宗教・宗派 ---------- */}
  <section class="section" aria-labelledby="religion">
    <div class="wrap-text prose" data-reveal>
      <p class="section__label">宗教・宗派</p>
      <h2 class="section__title" id="religion">宗教・宗派は問いません</h2>
      <p>
        霊園規約 第3条により、宗教・宗派を問わずご入会いただけます。規約 第18条では、植樹葬墓地において、自ら信ずる宗教・宗派等に基づく儀礼を自由に行えると定めています。
      </p>
      <p>ただし、合同追悼式については管理者（平成院）が執行します。</p>
    </div>
  </section>

  {/* ---------- 合同追悼式 ---------- */}
  <section class="section section--stone" aria-labelledby="memorial">
    <div class="wrap">
      <div data-reveal>
        <p class="section__label">年の行事</p>
        <h2 class="section__title" id="memorial">合同追悼式</h2>
        <p style="margin-top:var(--s5);max-width:var(--measure)">
          {site.memorialService.statement}
        </p>
        <p class="note" style="margin-top:var(--s4)">{site.memorialService.scope}</p>
      </div>
      <div style="margin-top:var(--s7)" data-reveal>
        <Figure name="memorial" sizes="100vw" />
      </div>
    </div>
  </section>

  {/* ---------- FAQ抜粋 ---------- */}
  <section class="section wrap" aria-labelledby="faq">
    <div data-reveal>
      <p class="section__label">よくあるご質問</p>
      <h2 class="section__title" id="faq">はじめての方から、よくいただくご質問</h2>
    </div>
    <div style="margin-top:var(--s6)" data-reveal>
      <FaqList onlyTop />
      <p style="margin-top:var(--s6)"><a class="link-more" href="/faq/">すべてのご質問を見る</a></p>
    </div>
  </section>

  {/* ---------- アクセス ---------- */}
  <section class="section section--stone" aria-labelledby="access">
    <div class="wrap" data-reveal>
      <p class="section__label">アクセス</p>
      <h2 class="section__title" id="access">所在地</h2>
      <p style="margin-top:var(--s5)">
        〒{site.office.postalCode}　{site.office.address}<br />
        <a href={site.office.telHref}>TEL {site.office.tel}</a>
      </p>
      <p><a class="link-more" href="/access/">アクセス・ご見学のご案内</a></p>
    </div>
  </section>

  {/* ---------- 見学CTA ---------- */}
  <section class="section" aria-labelledby="visit-cta">
    <div class="wrap-text" style="text-align:center" data-reveal>
      <h2 class="section__title" id="visit-cta">まずは、森を見にいらしてください</h2>
      <p style="margin-top:var(--s5)">
        ご見学・ご相談は、霊園事務局へお電話ください。
      </p>
      <p style="margin-top:var(--s6)">
        <a class="tel-big" href={site.office.telHref}>
          <span aria-hidden="true">☎</span>{site.office.tel}
        </a>
      </p>
      <p class="note" style="margin-top:var(--s4)">
        {site.hachinohe.label}　<a href={site.hachinohe.telHref}>{site.hachinohe.tel}</a>
      </p>
      <p class="note" style="margin-top:var(--s5)">
        墓参できる期間：{site.visit.period}／{site.visit.hours}<br />
        {site.visit.note}
      </p>
    </div>
  </section>
</BaseLayout>
